# Копия: cp .env.example .env  и заполни своими данными.
# НИКОГДА не коммить реальные пароли — используй плейсхолдеры.

# --- Подключение к БД (внешний кластер vesna-db7) ---
DATABASE_URL=postgresql://vdb7_user:%PAUSE_REAL_PASSWORD%PASSWORD_HERE@185.241.193.203:5432/vesna-db7
POSTGRES_DB=vesna-db7
POSTGRES_USER=vdb7_user
POSTGRES_PASSWORD=PASSWORD_HERE
POSTGRES_HOST=185.241.193.203
POSTGRES_PORT=5432

# --- LLM (Lead AI, P1) ---
# API совместимый с OpenAI (OpenAI, DeepSeek, Qwen, локальный шлюз).
# LLM_MODE: auto (реальный LLM при наличии ключа, иначе mock) | mock | real
# LLM_AUTH: auto (Yandex -> Api-Key, остальные -> Bearer) | bearer | apikey
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODE=auto
LLM_AUTH=auto
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# Yandex AI Studio (fallback, если LLM_* пустые):
# LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# YANDEX_CLOUD_API_KEY=AQVN...
# YANDEX_CLOUD_MODEL=deepseek-v4-flash/latest
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_MODEL=
YANDEX_CLOUD_FOLDER=

# --- Приложение ---
BACKEND_PORT=8000
APP_SECRET=change_me
